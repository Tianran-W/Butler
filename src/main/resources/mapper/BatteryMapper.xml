<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.BatteryMapper">

    <resultMap id="batteryVOResultMap" type="com.example.vo.BatteryVO">
        <id property="batteryId" column="battery_id"/>
        <result property="modelName" column="model_name"/>
        <result property="snCode" column="sn_code"/>
        <result property="status" column="status"/>
        <result property="lifespanCycles" column="lifespan_cycles"/>
        <result property="currentCycles" column="current_cycles"/>
    </resultMap>

    <select id="findAllBatteries" resultMap="batteryVOResultMap">
        SELECT
            battery_id,
            model_name,
            sn_code,
            status,
            lifespan_cycles,
            current_cycles
        FROM
            tb_battery
        WHERE
            status != '已报废'
        ORDER BY
            battery_id
    </select>

    <select id="findVOById" resultMap="batteryVOResultMap">
        SELECT
            battery_id,
            model_name,
            sn_code,
            status,
            lifespan_cycles,
            current_cycles
        FROM
            tb_battery
        WHERE
            battery_id = #{batteryId}
    </select>

</mapper>